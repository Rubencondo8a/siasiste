# ============================================================
# SIGAMETEC — Configuracion para produccion (HOSTING)
# ============================================================
# Copia este archivo al servidor con el nombre ".env"
# y completa las credenciales que te de tu hosting.
#
# IMPORTANTE: el archivo .env del servidor debe quedar FUERA de
# public/ (aqui esta en la raiz, junto a public/). Nunca lo subas
# dentro de la carpeta que el navegador pueda leer directamente.

# Aplicacion
APP_NAME=Sigametec
# Si la app queda en la raiz del subdominio (https://sigametec.tudominio.com/)
# usa BASE_URL=/
# Si la dejas en una subcarpeta (https://tudominio.com/sigametec/)
# usa BASE_URL=/sigametec/
BASE_URL=/sigametec/
# Zona horaria (Peru por defecto)
APP_TIMEZONE=America/Lima

# Base de datos (datos del hosting, NO los locales)
DB_HOST=localhost
DB_NAME=sigametec
DB_USER=root
DB_PASS=

# Seguridad del login
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900
# Tiempo de sesion en segundos (60 min por defecto)
SESSION_TIMEOUT=3600
